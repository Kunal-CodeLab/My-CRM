{
  "name": "@crm/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:phase0": "vitest run test/phase0",
    "test:phase1": "vitest run test/phase1",
    "test:phase2": "vitest run test/phase2",
    "test:phase3": "vitest run test/phase3",
    "test:phase4": "vitest run test/phase4",
    "test:phase5": "vitest run test/phase5",
    "test:team": "vitest run test/team",
    "test:seed": "vitest run test/seed",
    "db:start": "pglite-server --db=../../.pgdata --port=5432 -m=20",
    "db:migrate": "node -r dotenv/config dist/database/migrate.js",
    "seed": "node -r dotenv/config dist/database/seed.js"
  },
  "dependencies": {
    "@crm/shared-types": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.13",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.16",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.17.19",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
