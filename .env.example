# Environment Configuration Baseline (Local Development)
# DO NOT COMMIT PRODUCTION SECRETS

NODE_ENV=development
PORT=4000

# PostgreSQL Connection Strings by Role
# 1. Migrations (DDL Privileges)
DATABASE_MIGRATOR_URL=postgresql://crm_migrator:local_migrator_secret@localhost:5432/crm_dev?schema=public
# 2. Global Identity & Bootstrap (Least Privilege)
DATABASE_SYSTEM_URL=postgresql://crm_system_user:local_system_secret@localhost:5432/crm_dev?schema=public
# 3. Tenant Runtime Domain (Row-Level Security Enforced)
DATABASE_APP_URL=postgresql://crm_app_user:local_app_secret@localhost:5432/crm_dev?schema=public
# 4. Maintenance / Purge Role
DATABASE_MAINTENANCE_URL=postgresql://crm_maintenance:local_maintenance_secret@localhost:5432/crm_dev?schema=public

# Redis Connection (BullMQ & Rate Limits)
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO / Cloudflare R2)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin_secret
STORAGE_BUCKET=crm-exports
STORAGE_REGION=us-east-1

# JWT Secrets
JWT_ACCESS_SECRET=local_dev_jwt_access_secret_must_be_32_characters_minimum
JWT_REFRESH_SECRET=local_dev_jwt_refresh_secret_must_be_32_characters_minimum
